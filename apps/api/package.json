{
  "name": "@fraudpulse/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker.ts",
    "simulate": "tsx src/simulator.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "prisma generate && vitest run",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "5.19.1",
    "bullmq": "5.12.9",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.22.1",
    "helmet": "7.1.0",
    "ioredis": "5.4.1",
    "morgan": "1.11.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/morgan": "1.9.9",
    "@types/node": "20.14.10",
    "@types/supertest": "6.0.2",
    "prisma": "5.19.1",
    "supertest": "6.3.4",
    "tsx": "4.23.13",
    "typescript": "5.5.4",
    "vitest": "4.1.11"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
