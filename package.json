{
  "name": "fraudpulse",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm --filter @fraudpulse/web lint && python3 -m ruff check services/ml --select E9,F63,F7,F82,F401,F841",
    "format": "prettier -w .",
    "test": "pnpm -r test",
    "test:api": "pnpm --filter @fraudpulse/api test",
    "test:ml": "bash scripts/test-ml.sh",
    "db:migrate": "pnpm --filter @fraudpulse/api db:migrate",
    "seed": "pnpm --filter @fraudpulse/api db:seed",
    "simulate": "pnpm --filter @fraudpulse/api simulate",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "prettier": "3.3.3"
  }
}
